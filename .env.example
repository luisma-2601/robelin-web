# ── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca exponer en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ── Sitio ────────────────────────────────────────────────
# URL pública del sitio (CORS de /api/bcv-rate)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp de la tienda, formato internacional sin "+" (ej. 584141234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Integraciones ────────────────────────────────────────
# Webhook de n8n del asistente virtual. Si se deja vacío, el chat no se muestra.
NEXT_PUBLIC_CHAT_WEBHOOK_URL=
# Secreto para el cron de la tasa BCV (Vercel lo envía como "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=
